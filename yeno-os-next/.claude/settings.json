{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git config:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh pr:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(pnpm add:*)",
      "Bash(yarn add:*)",
      "Bash(pip install:*)",
      "Bash(sudo:*)",
      "Bash(apt-get install:*)",
      "Bash(printenv)",
      "Bash(env)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Write(./.env)",
      "Write(./migrations/CHECKSUMS.json)",
      "Write(./.claude/**)"
    ],
    "ask": ["Bash(git add:*)", "WebFetch", "WebSearch"],
    "allow": [
      "Bash(node --test:*)",
      "Bash(node src/cli.mjs:*)",
      "Bash(node scripts/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-guard.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/completion-guard.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
